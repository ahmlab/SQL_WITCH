    {"id": "empty_spells", "when": {"table": "spells", "change": "emptied", "actor": "player"}, "speaker": "foe", "line_key": "reaction.empty_spells", "effect": "foe_rages", "cooldown": 99},
    {"id": "insert_spell", "when": {"table": "spells", "change": "rows_added", "actor": "player"}, "speaker": "foe", "line_key": "reaction.insert_spell", "effect": "foe_rages", "cooldown": 99},
    {"id": "alter_spells", "when": {"table": "spells", "change": "rows_changed", "actor": "player"}, "speaker": "foe", "line_key": "reaction.alter_spells", "effect": "foe_rages", "cooldown": 99},
    {"id": "drop_foe_spells", "when": {"table": "foe_spells", "change": "dropped", "actor": "player"}, "speaker": "foe", "line_key": "reaction.drop_foe_spells", "effect": "foe_forgets", "cooldown": 99},
    {"id": "empty_foe_spells", "when": {"table": "foe_spells", "change": "emptied", "actor": "player"}, "speaker": "foe", "line_key": "reaction.empty_foe_spells", "effect": "foe_forgets", "cooldown": 99},
    {"id": "rename_foe_column", "when": {"table": "foe_spells", "change": "columns_changed", "actor": "player"}, "speaker": "foe", "line_key": "reaction.rename_foe_column", "effect": "foe_forgets", "cooldown": 99},
    {"id": "delete_foe_row", "when": {"table": "enemies", "change": "foe_row_removed", "actor": "player"}, "speaker": "foe", "line_key": "reaction.delete_foe_row", "effect": "fight_ends_confused", "cooldown": 99},
    {"id": "drop_enemies", "when": {"table": "enemies", "change": "dropped", "actor": "player"}, "speaker": "foe", "line_key": "reaction.drop_enemies", "effect": "fight_ends_confused", "cooldown": 99},
    {"id": "drop_items", "when": {"table": "items", "change": "dropped", "actor": "player"}, "speaker": "grimoire", "line_key": "reaction.drop_items", "effect": "none", "cooldown": 99},
    {"id": "drop_type_chart", "when": {"table": "type_chart", "change": "dropped", "actor": "player"}, "speaker": "foe", "line_key": "reaction.drop_type_chart", "effect": "forget_chart", "cooldown": 99},
    {"id": "core_lookalike", "when": {"table": "*", "change": "created", "actor": "player", "like_core": true}, "speaker": "foe", "line_key": "reaction.core_lookalike", "effect": "none", "cooldown": 3},
