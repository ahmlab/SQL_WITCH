    {"id": "transaction_left_open", "when": {"table": "*", "change": "transaction_left_open", "actor": "player"}, "speaker": "grimoire", "line_key": "miscast.transaction_left_open", "effect": "none", "cooldown": 0},
    {"id": "rewind", "when": {"table": "*", "change": "rewind", "actor": "player"}, "speaker": "foe", "line_key": "reaction.rewind", "effect": "none", "cooldown": 0}
